{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "name": "Receipt Tracker Web App (localhost:8080)",
            "request": "launch",
            "mainClass": "com.receipttracker.ReceiptTrackerServer",
            "workingDirectory": "c:/Users/NIVED/.gemini/antigravity/scratch/ReceiptTracker",
            "classPaths": [
                "c:/Users/NIVED/.gemini/antigravity/scratch/ReceiptTracker/target/ReceiptTracker-1.0.0.jar"
            ]
        },
        {
            "name": "Launch Chrome",
            "request": "launch",
            "type": "chrome",
            "url": "http://localhost:8080",
            "webRoot": "${workspaceFolder}"
        },
        {
            "type": "java",
            "name": "Receipt Tracker Desktop (Swing)",
            "request": "launch",
            "mainClass": "com.receipttracker.ReceiptTracker",
            "workingDirectory": "c:/Users/NIVED/.gemini/antigravity/scratch/ReceiptTracker",
            "vmArgs": "--enable-native-access=ALL-UNNAMED",
            "classPaths": [
                "c:/Users/NIVED/.gemini/antigravity/scratch/ReceiptTracker/target/ReceiptTracker-1.0.0.jar"
            ]
        }
    ]
}
